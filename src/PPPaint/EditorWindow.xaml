<Window x:Class="PPPaint.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:PPPaint">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" KeyDown="Root_KeyDown" KeyUp="Root_KeyUp">
        <Grid.Resources>
            <Style TargetType="Button"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="34"/></Style>
            <Style TargetType="ToggleButton"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="36"/></Style>
            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="16"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8,4">
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="NewButton" Content="新規" Click="New_Click" AutomationProperties.AutomationId="NewButton"/>
                    <Button x:Name="OpenButton" Content="開く" Click="Open_Click" AutomationProperties.AutomationId="OpenButton" ToolTipService.ToolTip="画像を開く (Ctrl+O)"/>
                    <Button x:Name="PasteButton" Content="貼り付け" Click="Paste_Click" AutomationProperties.AutomationId="PasteButton" ToolTipService.ToolTip="画像を貼り付け (Ctrl+V)"/>
                    <Button x:Name="CopyButton" Content="コピー" Click="Copy_Click" AutomationProperties.AutomationId="CopyButton" ToolTipService.ToolTip="画像をコピー (Ctrl+C)"/>
                    <Button x:Name="CutButton" Content="切り取り" Click="Cut_Click" AutomationProperties.AutomationId="CutButton" ToolTipService.ToolTip="選択範囲を切り取り (Ctrl+X)"/>
                    <Button x:Name="SaveButton" Content="保存" Click="Save_Click" AutomationProperties.AutomationId="SaveButton" ToolTipService.ToolTip="保存 (Ctrl+S)"/>
                    <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" AutomationProperties.Name="元に戻す" ToolTipService.ToolTip="元に戻す (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" AutomationProperties.Name="やり直す" ToolTipService.ToolTip="やり直す (Ctrl+Y)"/>
                    <Button x:Name="MoreButton" Content="その他" AutomationProperties.AutomationId="MoreButton"><Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="名前を付けて保存" Click="SaveAs_Click" AutomationProperties.AutomationId="SaveAsMenuItem"/>
                        <MenuFlyoutItem x:Name="OpenBackupMenuItem" Text="保存前の画像を開く" Click="OpenBackup_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenBackupMenuItem"/>
                        <MenuFlyoutItem Text="キャンバス全体を選択" Click="SelectAll_Click" AutomationProperties.AutomationId="SelectAllMenuItem" ToolTipService.ToolTip="キャンバス全体を範囲選択 (Ctrl+A)"/>
                        <MenuFlyoutItem Text="画像を重ねる" Click="InsertImage_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="右へ90度回転" Tag="Rotate" Click="Transform_Click"/>
                        <MenuFlyoutItem Text="左右反転" Tag="FlipX" Click="Transform_Click"/>
                        <MenuFlyoutItem Text="上下反転" Tag="FlipY" Click="Transform_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="画像を下に連結" Tag="Vertical" Click="Join_Click"/>
                        <MenuFlyoutItem Text="画像を右に連結" Tag="Horizontal" Click="Join_Click"/>
                    </MenuFlyout></Button.Flyout></Button>
                </StackPanel>
                </ScrollViewer>
                <Button x:Name="SettingsButton" Grid.Column="1" Content="設定" Click="Settings_Click" AutomationProperties.AutomationId="SettingsButton"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel x:Name="ToolsPanel" Orientation="Horizontal" Spacing="3" Padding="8,4"/>
        </ScrollViewer>
        <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8,2,8,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel x:Name="ColorsPanel" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"/>
                    <Button x:Name="CustomColorButton" Content="色" Click="CustomColor_Click" AutomationProperties.Name="色を指定"/>
                    <ToggleButton x:Name="EyedropperButton" Content="スポイト" Click="Eyedropper_Click" AutomationProperties.AutomationId="EyedropperButton"/>
                    <TextBlock x:Name="WidthCaption" Text="太さ" VerticalAlignment="Center"/>
                    <NumberBox x:Name="WidthBox" Width="92" Minimum="1" Maximum="100" Value="3" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="線の太さ"/>
                    <StackPanel x:Name="BlurOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="ぼかしの強さ" VerticalAlignment="Center"/>
                        <NumberBox x:Name="BlurRadiusBox" Width="90" Minimum="1" Maximum="64" Value="8" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="ぼかしの強さ"/>
                    </StackPanel>
                    <StackPanel x:Name="MosaicOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="モザイクの粗さ" VerticalAlignment="Center"/>
                        <NumberBox x:Name="MosaicSizeBox" Width="90" Minimum="2" Maximum="128" Value="12" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="モザイクの粗さ"/>
                    </StackPanel>
                    <StackPanel x:Name="OpacityOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="不透明度 (%)" VerticalAlignment="Center"/>
                        <NumberBox x:Name="OpacityBox" Width="90" Minimum="5" Maximum="100" Value="25" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="透かしの不透明度"/>
                    </StackPanel>
                    <StackPanel x:Name="TextOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="文字" VerticalAlignment="Center"/>
                        <NumberBox x:Name="FontBox" Width="96" Minimum="8" Maximum="200" Value="24" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="文字サイズ"/>
                        <TextBox x:Name="TextInput" Width="250" FontSize="16" PlaceholderText="テキスト" TextChanged="TextInput_Changed" AutomationProperties.Name="注釈テキスト"/>
                    </StackPanel>
                    <StackPanel x:Name="NumberOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="次の番号" VerticalAlignment="Center"/>
                        <NumberBox x:Name="NumberStartBox" Width="132" Minimum="1" Maximum="2147483647" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberStart_Changed" AutomationProperties.Name="次の番号"/>
                    </StackPanel>
                    <Button x:Name="CropButton" Content="切り抜き" Click="Crop_Click" IsEnabled="False" AutomationProperties.AutomationId="CropButton"/>
                    <Button x:Name="DeleteButton" Content="削除" Click="Delete_Click" IsEnabled="False" AutomationProperties.AutomationId="DeleteButton"/>
                    <Button x:Name="OrderButton" Content="重なり" IsEnabled="False" AutomationProperties.AutomationId="OrderButton"><Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="最前面へ" Tag="Front" Click="Order_Click"/>
                        <MenuFlyoutItem Text="1つ前へ" Tag="Forward" Click="Order_Click"/>
                        <MenuFlyoutItem Text="1つ後ろへ" Tag="Backward" Click="Order_Click"/>
                        <MenuFlyoutItem Text="最背面へ" Tag="Back" Click="Order_Click"/>
                    </MenuFlyout></Button.Flyout></Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="Viewport" Grid.Row="3" Background="#FFE4E7EC" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Disabled" SizeChanged="Viewport_SizeChanged" PointerWheelChanged="Canvas_Wheel">
            <Grid x:Name="CanvasSurface" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="CanvasImageBorder" Padding="10" Background="White">
                    <canvas:CanvasControl x:Name="PaintCanvas" Width="1000" Height="650" Draw="Canvas_Draw" CreateResources="Canvas_CreateResources" IsHitTestVisible="False" IsTabStop="False" AutomationProperties.Name="画像"/>
                </Border>
                <local:CursorHost x:Name="CanvasLeftGrip" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,10,0,10" Tag="Left" IsHitTestVisible="False" AutomationProperties.Name="キャンバス左辺"><Border MinWidth="8" MinHeight="8" Background="#FFC0CAD7"/></local:CursorHost>
                <local:CursorHost x:Name="CanvasRightGrip" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,10,0,10" Tag="Right" IsHitTestVisible="False" AutomationProperties.Name="キャンバス右辺"><Border MinWidth="8" MinHeight="8" Background="#FFC0CAD7"/></local:CursorHost>
                <local:CursorHost x:Name="CanvasTopGrip" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="10,0,10,0" Tag="Top" IsHitTestVisible="False" AutomationProperties.Name="キャンバス上辺"><Border MinWidth="8" MinHeight="8" Background="#FFC0CAD7"/></local:CursorHost>
                <local:CursorHost x:Name="CanvasBottomGrip" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="10,0,10,0" Tag="Bottom" IsHitTestVisible="False" AutomationProperties.Name="キャンバス下辺"><Border MinWidth="8" MinHeight="8" Background="#FFC0CAD7"/></local:CursorHost>
                <local:CursorHost x:Name="CanvasCursorHost" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    PointerPressed="Canvas_Pressed" PointerMoved="Canvas_Moved" PointerReleased="Canvas_Released" PointerCanceled="Canvas_Canceled" PointerCaptureLost="Canvas_CaptureLost" PointerEntered="Canvas_Entered" PointerExited="Canvas_Exited" PointerWheelChanged="Canvas_Wheel" DoubleTapped="Canvas_DoubleTapped">
                    <canvas:CanvasControl x:Name="InteractionCanvas" Width="1020" Height="670" ClearColor="Transparent" Draw="Interaction_Draw" IsTabStop="True" AutomationProperties.Name="画像編集領域"/>
                </local:CursorHost>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="4" Padding="8,3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="DimensionsButton" Content="1000 × 650 px" Click="Resize_Click" AutomationProperties.AutomationId="DimensionsButton" ToolTipService.ToolTip="画像サイズを変更"/>
                <Button x:Name="CanvasBackgroundButton" Content="背景" Click="CanvasBackground_Click" AutomationProperties.AutomationId="CanvasBackgroundButton"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="FitButton" Grid.Column="2" Content="全体" Click="Fit_Click" AutomationProperties.Name="画像全体を表示"/>
            <Slider x:Name="ZoomSlider" Grid.Column="3" Minimum="10" Maximum="400" Value="100" StepFrequency="5" ValueChanged="Zoom_Changed" VerticalAlignment="Center" AutomationProperties.Name="表示倍率"/>
            <Button x:Name="ZoomLabel" Grid.Column="4" Content="100%" Click="ZoomReset_Click" ToolTipService.ToolTip="100%表示"/>
        </Grid>
    </Grid>
</Window>
