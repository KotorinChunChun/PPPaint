<Window x:Class="PPPaint.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:PPPaint">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" KeyDown="Root_KeyDown" KeyUp="Root_KeyUp">
        <Grid.Resources>
            <Style TargetType="Button"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="34"/></Style>
            <Style TargetType="ToggleButton"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="36"/></Style>
            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="16"/></Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8,4">
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <local:ToolbarWrapPanel x:Name="CommandsPanel" Spacing="12" RowSpacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="FileButton" Content="ファイル▼" AutomationProperties.AutomationId="FileButton"><Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem x:Name="NewMenuItem" Text="新規" Click="New_Click" AutomationProperties.AutomationId="NewMenuItem"/>
                            <MenuFlyoutItem x:Name="OpenMenuItem" Text="開く" Click="Open_Click" AutomationProperties.AutomationId="OpenMenuItem"/>
                            <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="名前を付けて保存" Click="SaveAs_Click" AutomationProperties.AutomationId="SaveAsMenuItem"/>
                        </MenuFlyout></Button.Flyout></Button>
                        <Button x:Name="SaveButton" Content="保存" Click="Save_Click" AutomationProperties.AutomationId="SaveButton"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="CutButton" Content="切り取り" Click="Cut_Click" AutomationProperties.AutomationId="CutButton"/>
                        <Button x:Name="CopyButton" Content="コピー" Click="Copy_Click" AutomationProperties.AutomationId="CopyButton"/>
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button x:Name="PasteButton" Content="貼り付け" Click="Paste_Click" AutomationProperties.AutomationId="PasteButton"/>
                            <Button x:Name="PasteOptionsButton" Content="▼" Click="PasteOptions_Click" Padding="6,5" MinWidth="28" AutomationProperties.AutomationId="PasteOptionsButton"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" AutomationProperties.Name="元に戻す"/>
                        <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" AutomationProperties.Name="やり直す"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="CropButton" Content="切り抜き" Click="Crop_Click" IsEnabled="False" AutomationProperties.AutomationId="CropButton"/>
                        <Button x:Name="DeleteButton" Content="削除" Click="Delete_Click" IsEnabled="False" AutomationProperties.AutomationId="DeleteButton"/>
                        <Button x:Name="OrderButton" Content="重なり▼" IsEnabled="False" AutomationProperties.AutomationId="OrderButton"><Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="最前面へ" Tag="Front" Click="Order_Click"/>
                        <MenuFlyoutItem Text="1つ前へ" Tag="Forward" Click="Order_Click"/>
                        <MenuFlyoutItem Text="1つ後ろへ" Tag="Backward" Click="Order_Click"/>
                        <MenuFlyoutItem Text="最背面へ" Tag="Back" Click="Order_Click"/>
                    </MenuFlyout></Button.Flyout></Button>
                    </StackPanel>
                    <ToggleButton x:Name="ObjectPanelButton" Content="オブジェクト" Click="ObjectPanel_Click" AutomationProperties.AutomationId="ObjectPanelButton" ToolTipService.ToolTip="オブジェクト一覧を表示・非表示"/>
                    <Button x:Name="MoreButton" Content="その他▼" AutomationProperties.AutomationId="MoreButton"><Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Name="OpenBackupMenuItem" Text="保存前の画像を開く" Click="OpenBackup_Click" IsEnabled="False" AutomationProperties.AutomationId="OpenBackupMenuItem"/>
                        <MenuFlyoutItem Text="キャンバス全体を選択" Click="SelectAll_Click" AutomationProperties.AutomationId="SelectAllMenuItem" ToolTipService.ToolTip="キャンバス全体を範囲選択 (Ctrl+A)"/>
                        <MenuFlyoutItem Text="画像を重ねる" Click="InsertImage_Click"/>
                        <MenuFlyoutItem x:Name="MergeSelectionMenuItem" Text="選択を画像に統合" Click="MergeSelection_Click" IsEnabled="False" AutomationProperties.AutomationId="MergeSelectionMenuItem"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="右へ90度回転" Tag="Rotate" Click="Transform_Click"/>
                        <MenuFlyoutItem Text="左右反転" Tag="FlipX" Click="Transform_Click"/>
                        <MenuFlyoutItem Text="上下反転" Tag="FlipY" Click="Transform_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="画像を下に連結" Tag="Vertical" Click="Join_Click"/>
                        <MenuFlyoutItem Text="画像を右に連結" Tag="Horizontal" Click="Join_Click"/>
                    </MenuFlyout></Button.Flyout></Button>
                </local:ToolbarWrapPanel>
                <Button x:Name="SettingsButton" Grid.Column="1" Content="設定" Click="Settings_Click" VerticalAlignment="Top" AutomationProperties.AutomationId="SettingsButton"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="8,4">
            <local:ToolbarWrapPanel x:Name="ToolsPanel" Spacing="3" RowSpacing="3">
                <ToggleButton x:Name="EyedropperButton" Content="スポイト" Click="Eyedropper_Click" AutomationProperties.AutomationId="EyedropperButton"/>
            </local:ToolbarWrapPanel>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8,2,8,5">
            <StackPanel Spacing="4">
            <local:ToolbarWrapPanel x:Name="OptionsPanel" Spacing="12" RowSpacing="4">
                <StackPanel x:Name="ColorOptions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <StackPanel x:Name="ColorsPanel" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"/>
                    <Button x:Name="CustomColorButton" Content="色1" Click="CustomColor_Click" AutomationProperties.Name="色1を指定"/>
                    <Button x:Name="SecondaryColorButton" Content="色2" Click="SecondaryColor_Click" ToolTipService.ToolTip="色2を指定（右ボタン用）" AutomationProperties.Name="色2を指定"/>
                    <Button x:Name="AdoptStyleButton" Content="設定を取得" Click="AdoptStyle_Click" IsEnabled="False" AutomationProperties.AutomationId="AdoptStyleButton"/>
                </StackPanel>
                <StackPanel x:Name="WidthOptions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="WidthCaption" Text="太さ" VerticalAlignment="Center"/>
                    <NumberBox x:Name="WidthBox" Width="92" Minimum="1" Maximum="100" Value="3" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="線の太さ"/>
                </StackPanel>
                <StackPanel x:Name="BlurOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="ぼかしの強さ" VerticalAlignment="Center"/>
                    <NumberBox x:Name="BlurRadiusBox" Width="90" Minimum="1" Maximum="64" Value="8" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="ぼかしの強さ"/>
                </StackPanel>
                <StackPanel x:Name="MosaicOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="モザイクの粗さ" VerticalAlignment="Center"/>
                    <NumberBox x:Name="MosaicSizeBox" Width="90" Minimum="2" Maximum="128" Value="12" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="モザイクの粗さ"/>
                </StackPanel>
                <StackPanel x:Name="OpacityOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="不透明度 (%)" VerticalAlignment="Center"/>
                    <NumberBox x:Name="OpacityBox" Width="90" Minimum="5" Maximum="100" Value="100" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="文字の不透明度"/>
                </StackPanel>
                <StackPanel x:Name="NumberOptions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="次の番号" VerticalAlignment="Center"/>
                    <NumberBox x:Name="NumberStartBox" Width="132" Minimum="1" Maximum="2147483647" Value="1" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberStart_Changed" AutomationProperties.Name="次の番号"/>
                </StackPanel>
            </local:ToolbarWrapPanel>
            <Grid x:Name="TextOptions" ColumnSpacing="8" Visibility="Collapsed" AutomationProperties.AutomationId="TextOptions">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="文字サイズ" VerticalAlignment="Center"/>
                <NumberBox x:Name="FontBox" Grid.Column="1" Width="96" Minimum="8" Maximum="200" Value="24" SpinButtonPlacementMode="Compact" ValueChanged="Style_Changed" AutomationProperties.Name="文字サイズ"/>
                <TextBox x:Name="TextInput" Grid.Column="2" MinWidth="240" MinHeight="36" MaxHeight="112" FontSize="16" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="テキスト" TextChanged="TextInput_Changed" AutomationProperties.Name="注釈テキスト"/>
            </Grid>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Viewport" Grid.Row="3" Background="#FFE4E7EC" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Disabled" SizeChanged="Viewport_SizeChanged" PointerWheelChanged="Canvas_Wheel" PointerPressed="Viewport_Pressed">
            <Grid Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True">
                <Grid.Resources>
                    <Style x:Key="CanvasGrip" TargetType="Border">
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#FF466684"/>
                        <Setter Property="Background" Value="#FFDAE9F8"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition x:Name="CanvasImageColumn" Width="1000"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition x:Name="CanvasImageRow" Height="650"/><RowDefinition Height="10"/></Grid.RowDefinitions>
                <canvas:CanvasControl x:Name="PaintCanvas" Grid.Row="1" Grid.Column="1" Draw="Canvas_Draw" CreateResources="Canvas_CreateResources" IsHitTestVisible="False" IsTabStop="False" AutomationProperties.Name="画像"/>
                <Border x:Name="CanvasTopLeftGrip" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス左上角"/>
                <Border x:Name="CanvasTopGrip" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス上辺"/>
                <Border x:Name="CanvasTopRightGrip" Grid.Column="2" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス右上角"/>
                <Border x:Name="CanvasLeftGrip" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス左辺"/>
                <Border x:Name="CanvasRightGrip" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス右辺"/>
                <Border x:Name="CanvasBottomLeftGrip" Grid.Row="2" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス左下角"/>
                <Border x:Name="CanvasBottomGrip" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス下辺"/>
                <Border x:Name="CanvasBottomRightGrip" Grid.Row="2" Grid.Column="2" Style="{StaticResource CanvasGrip}" AutomationProperties.Name="キャンバス右下角"/>
                <local:CursorHost x:Name="CanvasCursorHost" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    PointerPressed="Canvas_Pressed" PointerMoved="Canvas_Moved" PointerReleased="Canvas_Released" PointerCanceled="Canvas_Canceled" PointerCaptureLost="Canvas_CaptureLost" PointerEntered="Canvas_Entered" PointerExited="Canvas_Exited" PointerWheelChanged="Canvas_Wheel" DoubleTapped="Canvas_DoubleTapped">
                    <canvas:CanvasControl x:Name="InteractionCanvas" ClearColor="Transparent" Draw="Interaction_Draw" IsTabStop="True" AutomationProperties.Name="画像編集領域"/>
                </local:CursorHost>
            </Grid>
        </ScrollViewer>
        <canvas:CanvasControl x:Name="CanvasResizeOverlay" Grid.Row="3" Draw="CanvasResizeOverlay_Draw" ClearColor="Transparent" IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
        <Border x:Name="ObjectPanel" Grid.Row="3" Grid.Column="1" Width="224" Padding="8" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ToggleButton x:Name="ObjectHandlesButton" Content="全ハンドル表示" Click="ObjectHandles_Click"
                              AutomationProperties.AutomationId="ObjectHandlesButton" ToolTipService.ToolTip="すべてのオブジェクトの位置にハンドルを表示"/>
                <ListView x:Name="ObjectList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="ObjectList_SelectionChanged"
                          AutomationProperties.AutomationId="ObjectList" AutomationProperties.Name="オブジェクト一覧（上から前面順）"/>
                <StackPanel x:Name="ObjectOrderButtons" Grid.Row="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="⤒" Tag="Front" Click="Order_Click" ToolTipService.ToolTip="最前面へ" AutomationProperties.Name="最前面へ"/>
                    <Button Content="↑" Tag="Forward" Click="Order_Click" ToolTipService.ToolTip="1つ前へ" AutomationProperties.Name="1つ前へ"/>
                    <Button Content="↓" Tag="Backward" Click="Order_Click" ToolTipService.ToolTip="1つ後ろへ" AutomationProperties.Name="1つ後ろへ"/>
                    <Button Content="⤓" Tag="Back" Click="Order_Click" ToolTipService.ToolTip="最背面へ" AutomationProperties.Name="最背面へ"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Padding="8,3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="DimensionsButton" Content="1000 × 650 px" Click="Resize_Click" AutomationProperties.AutomationId="DimensionsButton" ToolTipService.ToolTip="画像サイズを変更"/>
                <Button x:Name="CanvasBackgroundButton" Content="背景" Click="CanvasBackground_Click" AutomationProperties.AutomationId="CanvasBackgroundButton"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ToggleButton x:Name="FitButton" Grid.Column="2" Content="全体" Checked="Fit_Checked" Unchecked="Fit_Unchecked" AutomationProperties.Name="画像全体を表示"/>
            <Slider x:Name="ZoomSlider" Grid.Column="3" Minimum="10" Maximum="400" Value="100" StepFrequency="5" ValueChanged="Zoom_Changed" VerticalAlignment="Center" AutomationProperties.Name="表示倍率"/>
            <Button x:Name="ZoomLabel" Grid.Column="4" Content="100%" Click="ZoomReset_Click" ToolTipService.ToolTip="100%表示"/>
        </Grid>
    </Grid>
</Window>
