<Window
    x:Class="ChunPaint.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:ChunPaint"
    Title="無題 - ChunPaint">

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" UseLayoutRounding="True" AllowDrop="True" DragOver="Document_DragOver" Drop="Document_Drop">
        <Grid.Resources>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="AccessibleControl" TargetType="Control">
                <Setter Property="IsTabStop" Value="True" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="48" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/ChunPaintIcon.svg" Width="28" Height="28" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="ChunPaint ロゴ" />
                <MenuBar Grid.Column="1" Padding="0,0,8,0" Background="Transparent" AutomationProperties.Name="メインメニュー">
                <MenuBarItem Title="ファイル" AutomationProperties.Name="ファイルメニュー">
                    <MenuFlyoutItem Text="新規" Click="New_Click" />
                    <MenuFlyoutItem Text="開く" Click="Open_Click" />
                    <MenuFlyoutSubItem Text="キャンバスにインポート">
                        <MenuFlyoutItem Text="ファイルから" Click="Import_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="最近使ったファイル" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="保存" Click="Save_Click" />
                    <MenuFlyoutItem Text="プロジェクトとして保存" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" Tag="chunpaint" Click="SaveAs_Click" />
                    <MenuFlyoutSubItem Text="名前を付けて保存">
                        <MenuFlyoutItem Text="ChunPaint プロジェクト" Tag="chunpaint" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="PNG 画像" Tag="png" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="JPEG 画像" Tag="jpg" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="BMP 画像" Tag="bmp" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="GIF 画像" Tag="gif" Click="SaveAs_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="印刷" KeyboardAcceleratorTextOverride="Ctrl+P" Click="Print_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="デスクトップの背景として設定">
                        <MenuFlyoutItem Text="画面に合わせる" Tag="Fill" Click="Wallpaper_Click" />
                        <MenuFlyoutItem Text="並べて表示" Tag="Tile" Click="Wallpaper_Click" />
                        <MenuFlyoutItem Text="中央に表示" Tag="Center" Click="Wallpaper_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="画像のプロパティ" Click="Properties_Click" />
                    <MenuFlyoutItem Text="終了" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="編集" AutomationProperties.Name="編集メニュー">
                    <MenuFlyoutItem x:Name="UndoMenuItem" Text="元に戻す" Click="Undo_Click" />
                    <MenuFlyoutItem x:Name="RedoMenuItem" Text="やり直し" Click="Redo_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="選択">
                        <MenuFlyoutItem Text="矩形選択" Click="RectangleSelection_Click" />
                        <MenuFlyoutItem Text="自由選択" Click="FreeSelection_Click" />
                        <MenuFlyoutItem x:Name="SelectAllMenuItem" Text="すべて選択" KeyboardAcceleratorTextOverride="Ctrl+A" Click="SelectAll_Click" />
                        <MenuFlyoutItem Text="選択範囲を反転" Click="InvertSelectionRegion_Click" />
                        <ToggleMenuFlyoutItem x:Name="TransparentSelectionMenuItem" Text="透明な選択" Click="ToggleTransparentSelection_Click" />
                        <MenuFlyoutItem x:Name="SelectionApplyMenuItem" Text="選択を適用" KeyboardAcceleratorTextOverride="Ctrl+Space" Click="ApplySelection_Click" />
                        <MenuFlyoutItem x:Name="SelectionCancelMenuItem" Text="選択をキャンセル" KeyboardAcceleratorTextOverride="Esc" Click="CancelSelection_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="オブジェクト">
                        <MenuFlyoutItem x:Name="ObjectApplyMenuItem" Text="オブジェクトを適用" KeyboardAcceleratorTextOverride="Ctrl+Space" Click="ApplyObject_Click" />
                        <MenuFlyoutItem x:Name="ObjectCancelMenuItem" Text="オブジェクトをキャンセル" KeyboardAcceleratorTextOverride="Esc" Click="CancelObject_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="CutMenuItem" Text="切り取り" IsEnabled="False" Click="Cut_Click" />
                    <MenuFlyoutItem x:Name="CopyMenuItem" Text="コピー" IsEnabled="False" Click="Copy_Click" />
                    <MenuFlyoutItem x:Name="CopyVisibleLayersMenuItem" Text="表示レイヤーをコピー" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" IsEnabled="False" Click="CopyVisibleLayers_Click" />
                    <MenuFlyoutItem x:Name="PasteMenuItem" Text="貼り付け" Click="Paste_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="削除" IsEnabled="False" Click="Delete_Click" />
                    <MenuFlyoutItem x:Name="InvertMenuItem" Text="色の反転" IsEnabled="False" Click="Invert_Click" />
                </MenuBarItem>
                <MenuBarItem Title="表示" AutomationProperties.Name="表示メニュー">
                    <ToggleMenuFlyoutItem x:Name="RulerMenuItem" Text="ルーラー" Click="Ruler_Click" />
                    <ToggleMenuFlyoutItem x:Name="GridMenuItem" Text="グリッド線" Click="Grid_Click" />
                    <ToggleMenuFlyoutItem x:Name="StatusBarMenuItem" Text="ステータス バー" IsChecked="True" Click="StatusBar_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="100%" Click="ResetZoom_Click" />
                    <ToggleMenuFlyoutItem x:Name="FullScreenMenuItem" Text="全画面表示" KeyboardAcceleratorTextOverride="F11" Click="FullScreen_Click" />
                </MenuBarItem>
                </MenuBar>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="SaveToolbarButton" Style="{StaticResource ToolbarButton}" Width="42" Height="38" Padding="0" Click="Save_Click" ToolTipService.ToolTip="保存 (Ctrl+S)" AutomationProperties.Name="保存" AutomationProperties.HelpText="現在のドキュメントを保存します。Ctrl+S">
                    <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="{ThemeResource SystemControlForegroundBaseHighBrush}" Data="M 2,1 H 17 L 21,5 V 21 H 1 V 1 Z" />
                        <Path Fill="{ThemeResource SystemControlBackgroundAltHighBrush}" Data="M 5,1 H 15 V 7 H 5 Z" />
                        <Path Fill="{ThemeResource SystemControlBackgroundAltHighBrush}" Data="M 5,13 H 17 V 20 H 5 Z" />
                        <Path Fill="{ThemeResource SystemControlForegroundBaseHighBrush}" Data="M 7,14 H 15 V 19 H 7 Z" />
                    </Canvas>
                </Button>
                <Button x:Name="ShareToolbarButton" Style="{StaticResource ToolbarButton}" Width="42" Height="38" Padding="0" Click="Share_Click" ToolTipService.ToolTip="共有" AutomationProperties.Name="共有" AutomationProperties.HelpText="画像をWindowsの共有画面へ渡します">
                    <Path Width="22" Height="22" Stretch="Uniform" Fill="{ThemeResource SystemControlForegroundBaseHighBrush}" Data="M 9,21 V 8 H 2 L 11,0 L 20,8 H 13 V 21 Z" />
                </Button>
                <Rectangle Width="1" Height="30" Margin="4,0" Fill="#FFE1E1E1" />
                <Button Style="{StaticResource ToolbarButton}" Width="42" Height="38" Padding="0" Click="Undo_Click" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" AutomationProperties.Name="元に戻す" AutomationProperties.HelpText="直前の編集を取り消します。Ctrl+Z"><TextBlock FontSize="24" Text="↶" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="42" Height="38" Padding="0" Click="Redo_Click" ToolTipService.ToolTip="やり直す (Ctrl+Y)" AutomationProperties.Name="やり直す" AutomationProperties.HelpText="取り消した編集をやり直します。Ctrl+Y"><TextBlock FontSize="24" Text="↷" /></Button>
                <ToggleButton x:Name="ButtonDisplayModeToggleButton" Style="{StaticResource ToolbarToggleButton}" Width="42" Height="38" Padding="0" Click="ButtonDisplayModeToggle_Click" ToolTipService.ToolTip="ボタンをアイコン表示／名前表示に切り替え" AutomationProperties.Name="ボタン表示モード" AutomationProperties.HelpText="リボンとツールバーのボタン表示をアイコンまたは名前へ切り替えます"><TextBlock FontSize="14" Text="A▣" /></ToggleButton>
                <Button x:Name="ZoomOutToolbarButton" Style="{StaticResource ToolbarButton}" Width="42" Height="38" Padding="0" Background="Transparent" Click="ZoomOut_Click" Content="⌕" AutomationProperties.Name="ズームアウト" ToolTipService.ToolTip="ズームアウト" />
                <Button x:Name="ZoomInToolbarButton" Style="{StaticResource ToolbarButton}" Width="42" Height="38" Padding="0" Background="Transparent" Click="ZoomIn_Click" Content="⊕" AutomationProperties.Name="ズームイン" ToolTipService.ToolTip="ズームイン" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" Margin="0,0,14,0" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButton}" Width="38" Height="38" Padding="0" Background="Transparent" Click="Feedback_Click" ToolTipService.ToolTip="フィードバック" AutomationProperties.Name="フィードバック"><TextBlock FontSize="21" Text="⌁" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="38" Height="38" Padding="0" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="19" Click="Account_Click" ToolTipService.ToolTip="アカウント" AutomationProperties.Name="アカウント"><TextBlock FontSize="18" Text="♙" /></Button>
                <Button Style="{StaticResource ToolbarButton}" Width="38" Height="38" Padding="0" Background="Transparent" Click="Settings_Click" ToolTipService.ToolTip="設定" AutomationProperties.Name="設定" AutomationProperties.HelpText="表示とアクセシビリティの設定を開きます"><TextBlock FontSize="22" Text="⚙" /></Button>
            </StackPanel>
        </Grid>

        <Border x:Name="RibbonBorder" Grid.Row="1" MinHeight="136" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="RibbonScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled" AutomationProperties.Name="リボン操作領域">
                <Grid x:Name="RibbonGroups" MinHeight="136" AutomationProperties.Name="ツールリボン">
                    <Grid.Resources>
                        <Style x:Key="RibbonToggle" TargetType="ToggleButton">
                            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="21" />
                            <Setter Property="CornerRadius" Value="5" /><Setter Property="IsTabStop" Value="True" />
                        </Style>
                        <Style x:Key="RibbonButton" TargetType="Button">
                            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
                            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="21" />
                            <Setter Property="CornerRadius" Value="5" /><Setter Property="Background" Value="Transparent" /><Setter Property="IsTabStop" Value="True" />
                        </Style>
                        <Style x:Key="ShapeButton" TargetType="Button">
                            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="22" />
                            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="16" />
                            <Setter Property="CornerRadius" Value="3" /><Setter Property="Background" Value="Transparent" /><Setter Property="IsTabStop" Value="True" />
                        </Style>
                        <Style x:Key="Swatch" TargetType="Button">
                            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" />
                            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="IsTabStop" Value="True" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="SelectionRibbonGroup" Grid.Column="0" Width="124">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,6">
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="RectangleSelectionButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource RibbonToggle}" Click="RectangleSelection_Click" ToolTipService.ToolTip="矩形選択" AutomationProperties.Name="矩形選択" AutomationProperties.HelpText="矩形範囲で選択を開始します"><TextBlock Text="□" /></ToggleButton>
                            <ToggleButton x:Name="FreeSelectionButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource RibbonToggle}" Click="FreeSelection_Click" ToolTipService.ToolTip="自由選択" AutomationProperties.Name="自由選択" AutomationProperties.HelpText="自由な形状の範囲で選択を開始します"><TextBlock Text="⌁" /></ToggleButton>
                            <Button x:Name="SelectAllButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="SelectAll_Click" ToolTipService.ToolTip="すべて選択 (Ctrl+A)" AutomationProperties.Name="すべて選択" AutomationProperties.HelpText="キャンバス全体を選択します。Ctrl+Aでも実行できます"><TextBlock Text="▣" /></Button>
                            <Button x:Name="CancelSelectionButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource RibbonButton}" Click="CancelSelection_Click" ToolTipService.ToolTip="選択をキャンセル (Escape)" AutomationProperties.Name="選択をキャンセル" AutomationProperties.HelpText="現在の選択範囲を取り消します。Escapeでも実行できます"><TextBlock Text="×" /></Button>
                            <ToggleButton x:Name="TransparentSelectionButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource RibbonToggle}" Click="ToggleTransparentSelection_Click" ToolTipService.ToolTip="透明な選択" AutomationProperties.Name="透明な選択" AutomationProperties.HelpText="選択時に背景色を透明として扱います"><TextBlock Text="◌" /></ToggleButton>
                            <Button x:Name="DeleteSelectionButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="Delete_Click" ToolTipService.ToolTip="選択範囲を削除 (Delete)" AutomationProperties.Name="選択範囲を削除" AutomationProperties.HelpText="選択範囲の内容を削除します。Deleteでも実行できます"><TextBlock Text="⌫" /></Button>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Text="選択した部分" />
                    </Grid>
                    <Rectangle Grid.Column="1" Width="1" Fill="#FFE6E6E6" />

                    <Grid x:Name="ImageRibbonGroup" Grid.Column="2" Width="124">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="CropMenuItem" Grid.Row="0" Grid.Column="0" Style="{StaticResource RibbonButton}" Click="Crop_Click" IsEnabled="False" ToolTipService.ToolTip="トリミング" AutomationProperties.Name="トリミング"><TextBlock Text="⌜" /></Button>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource RibbonButton}" Click="Resize_Click" ToolTipService.ToolTip="サイズ変更" AutomationProperties.Name="サイズ変更"><Image Width="24" Height="24" Source="ms-appx:///Assets/RibbonIcons/final/resize.png" Stretch="Uniform" /></Button>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="Import_Click" ToolTipService.ToolTip="キャンバスにインポート" AutomationProperties.Name="キャンバスにインポート"><TextBlock Text="▧" /></Button>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource RibbonButton}" Click="BackgroundRemoval_Click" ToolTipService.ToolTip="背景の削除" AutomationProperties.Name="背景の削除"><TextBlock Text="▥" /></Button>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RibbonButton}" Click="Rotate_Click" ToolTipService.ToolTip="回転" AutomationProperties.Name="回転"><TextBlock Text="◢" /></Button>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="Rotate_Click" ToolTipService.ToolTip="回転メニュー" AutomationProperties.Name="回転メニュー"><TextBlock FontSize="14" Text="⌄" /></Button>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Text="イメージ" />
                    </Grid>
                    <Rectangle Grid.Column="3" Width="1" Fill="#FFE6E6E6" />

                    <Grid x:Name="ToolsRibbonGroup" Grid.Column="4" Width="124">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="PencilToolButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource RibbonToggle}" Tag="Pencil" IsChecked="True" Click="PencilButton_Click" ToolTipService.ToolTip="鉛筆・ブラシの種類" AutomationProperties.Name="鉛筆・ブラシの種類"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1"><TextBlock Text="✎" /><Image Width="15" Height="15" Source="ms-appx:///Assets/RibbonIcons/final/brush.png" Stretch="Uniform" /><TextBlock FontSize="9" VerticalAlignment="Bottom" Text="⌄" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="FillToolButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource RibbonToggle}" Tag="Fill" Click="ToolButton_Click" ToolTipService.ToolTip="塗りつぶし" AutomationProperties.Name="塗りつぶしツール"><Image Width="24" Height="24" Source="ms-appx:///Assets/RibbonIcons/final/fill.png" Stretch="Uniform" /></ToggleButton>
                            <ToggleButton x:Name="TextToolButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource RibbonToggle}" Tag="Text" Click="ToolButton_Click" ToolTipService.ToolTip="テキスト" AutomationProperties.Name="テキストツール"><TextBlock Text="A" /></ToggleButton>
                            <ToggleButton x:Name="EraserToolButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource RibbonToggle}" Tag="Eraser" Click="ToolButton_Click" ToolTipService.ToolTip="消しゴム" AutomationProperties.Name="消しゴムツール"><Image Width="24" Height="24" Source="ms-appx:///Assets/RibbonIcons/final/eraser.png" Stretch="Uniform" /></ToggleButton>
                            <ToggleButton x:Name="PickerToolButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource RibbonToggle}" Tag="Picker" Click="ToolButton_Click" ToolTipService.ToolTip="スポイト" AutomationProperties.Name="スポイトツール"><TextBlock Text="⚕" /></ToggleButton>
                            <ToggleButton x:Name="ZoomToolButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonToggle}" Tag="Zoom" Click="ToolButton_Click" ToolTipService.ToolTip="左クリックで10%拡大／右クリックで10%縮小（選択だけでは倍率は変わりません）" AutomationProperties.Name="拡大鏡ツール" AutomationProperties.HelpText="選択後、左クリックで10%拡大、右クリックで10%縮小します。選択だけでは倍率は変わりません。"><TextBlock Text="⌕" /></ToggleButton>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Text="ツール" />
                    </Grid>
                    <Rectangle Grid.Column="5" Width="1" Fill="#FFE6E6E6" />

                    <Grid x:Name="ShapesRibbonGroup" Grid.Column="6">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="6,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="136" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="168">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ShapeButton}" Content="╲" Tag="Line" Click="ShapeButton_Click" AutomationProperties.Name="直線" /><Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ShapeButton}" Content="∿" Tag="Curve" Click="ShapeButton_Click" AutomationProperties.Name="曲線" /><Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ShapeButton}" Content="○" Tag="Ellipse" Click="ShapeButton_Click" AutomationProperties.Name="楕円" /><Button Grid.Row="0" Grid.Column="3" Style="{StaticResource ShapeButton}" Content="□" Tag="Rectangle" Click="ShapeButton_Click" AutomationProperties.Name="四角形" /><Button Grid.Row="0" Grid.Column="4" Style="{StaticResource ShapeButton}" Content="▢" Tag="RoundedRectangle" Click="ShapeButton_Click" AutomationProperties.Name="角丸四角形" /><Button Grid.Row="0" Grid.Column="5" Style="{StaticResource ShapeButton}" Content="▱" Tag="Parallelogram" Click="ShapeButton_Click" AutomationProperties.Name="平行四辺形" />
                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ShapeButton}" Content="△" Tag="Triangle" Click="ShapeButton_Click" AutomationProperties.Name="三角形" /><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ShapeButton}" Content="◿" Tag="RightTriangle" Click="ShapeButton_Click" AutomationProperties.Name="直角三角形" /><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ShapeButton}" Content="◇" Tag="Diamond" Click="ShapeButton_Click" AutomationProperties.Name="ひし形" /><Button Grid.Row="1" Grid.Column="3" Style="{StaticResource ShapeButton}" Content="⬠" Tag="Pentagon" Click="ShapeButton_Click" AutomationProperties.Name="五角形" /><Button Grid.Row="1" Grid.Column="4" Style="{StaticResource ShapeButton}" Content="⬡" Tag="Hexagon" Click="ShapeButton_Click" AutomationProperties.Name="六角形" /><Button Grid.Row="1" Grid.Column="5" Style="{StaticResource ShapeButton}" Content="➡" Tag="RightArrow" Click="ShapeButton_Click" AutomationProperties.Name="右矢印" />
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource ShapeButton}" Content="⬅" Tag="LeftArrow" Click="ShapeButton_Click" AutomationProperties.Name="左矢印" /><Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ShapeButton}" Content="⬆" Tag="UpArrow" Click="ShapeButton_Click" AutomationProperties.Name="上矢印" /><Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ShapeButton}" Content="⬇" Tag="DownArrow" Click="ShapeButton_Click" AutomationProperties.Name="下矢印" /><Button Grid.Row="2" Grid.Column="3" Style="{StaticResource ShapeButton}" Content="✧" Tag="FourPointStar" Click="ShapeButton_Click" AutomationProperties.Name="四角星" /><Button Grid.Row="2" Grid.Column="4" Style="{StaticResource ShapeButton}" Content="☆" Tag="Star" Click="ShapeButton_Click" AutomationProperties.Name="星" /><Button Grid.Row="2" Grid.Column="5" Style="{StaticResource ShapeButton}" Content="★" Tag="FilledStar" Click="ShapeButton_Click" AutomationProperties.Name="塗りつぶし星形" />
