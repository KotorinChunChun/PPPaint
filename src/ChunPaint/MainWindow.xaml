<Window
    x:Class="ChunPaint.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="無題 - ChunPaint">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="136" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FFFAFAFA" BorderBrush="#FFE8E8E8" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <MenuBar Grid.Column="0" Padding="8,0" Background="Transparent">
                <MenuBarItem Title="ファイル">
                    <MenuFlyoutItem Text="新規" Click="New_Click" />
                    <MenuFlyoutItem Text="開く" Click="Open_Click" />
                    <MenuFlyoutSubItem Text="キャンバスにインポート">
                        <MenuFlyoutItem Text="ファイルから" Click="Import_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="保存" Click="Save_Click" />
                    <MenuFlyoutSubItem Text="名前を付けて保存">
                        <MenuFlyoutItem Text="ChunPaint プロジェクト" Tag="chunpaint" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="PNG 画像" Tag="png" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="JPEG 画像" Tag="jpg" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="BMP 画像" Tag="bmp" Click="SaveAs_Click" />
                        <MenuFlyoutItem Text="GIF 画像" Tag="gif" Click="SaveAs_Click" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="画像のプロパティ" Click="Properties_Click" />
                    <MenuFlyoutItem Text="終了" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="編集">
                    <MenuFlyoutItem x:Name="UndoMenuItem" Text="元に戻す" Click="Undo_Click" />
                    <MenuFlyoutItem x:Name="RedoMenuItem" Text="やり直し" Click="Redo_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="CutMenuItem" Text="切り取り" IsEnabled="False" Click="Cut_Click" />
                    <MenuFlyoutItem x:Name="CopyMenuItem" Text="コピー" IsEnabled="False" Click="Copy_Click" />
                    <MenuFlyoutItem x:Name="PasteMenuItem" Text="貼り付け" Click="Paste_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="削除" IsEnabled="False" Click="Delete_Click" />
                    <MenuFlyoutItem x:Name="InvertMenuItem" Text="色の反転" IsEnabled="False" Click="Invert_Click" />
                </MenuBarItem>
                <MenuBarItem Title="表示">
                    <ToggleMenuFlyoutItem Text="ルーラー" Click="Ruler_Click" />
                    <ToggleMenuFlyoutItem Text="グリッド線" Click="Grid_Click" />
                    <ToggleMenuFlyoutItem Text="ステータス バー" IsChecked="True" Click="StatusBar_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="100%" Click="ResetZoom_Click" />
                </MenuBarItem>
            </MenuBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Width="42" Height="38" Padding="0" Click="Save_Click" ToolTipService.ToolTip="保存 (Ctrl+S)"><TextBlock FontSize="21" Text="▣" /></Button>
                <Button Width="42" Height="38" Padding="0" Click="Import_Click" ToolTipService.ToolTip="共有"><TextBlock FontSize="21" Text="↗" /></Button>
                <Rectangle Width="1" Height="30" Margin="4,0" Fill="#FFE1E1E1" />
                <Button Width="42" Height="38" Padding="0" Click="Undo_Click" ToolTipService.ToolTip="元に戻す (Ctrl+Z)"><TextBlock FontSize="24" Text="↶" /></Button>
                <Button Width="42" Height="38" Padding="0" Click="Redo_Click" ToolTipService.ToolTip="やり直し (Ctrl+Y)"><TextBlock FontSize="24" Text="↷" /></Button>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" Margin="0,0,14,0" VerticalAlignment="Center">
                <Button Width="38" Height="38" Padding="0" Background="Transparent"><TextBlock FontSize="21" Text="⌁" /></Button>
                <Button Width="38" Height="38" Padding="0" Background="#FFE7E7E7" CornerRadius="19"><TextBlock FontSize="18" Text="♙" /></Button>
                <Button Width="38" Height="38" Padding="0" Background="Transparent"><TextBlock FontSize="22" Text="⚙" /></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE3E3E3" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                <Grid Height="136" MinWidth="1535">
                    <Grid.Resources>
                        <Style x:Key="RibbonToggle" TargetType="ToggleButton">
                            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" />
                            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="21" />
                            <Setter Property="CornerRadius" Value="5" />
                        </Style>
                        <Style x:Key="RibbonButton" TargetType="Button">
                            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="42" />
                            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="21" />
                            <Setter Property="CornerRadius" Value="5" /><Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style x:Key="ShapeButton" TargetType="Button">
                            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="18" />
                            <Setter Property="CornerRadius" Value="3" /><Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style x:Key="Swatch" TargetType="Button">
                            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" />
                            <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="11" />
                            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="#FFB0B0B0" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="113" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="197" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="172" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="361" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="441" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="1" />
                        <ColumnDefinition Width="88" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <ToggleButton x:Name="SelectToolButton" Grid.Row="0" Width="72" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="Select" Click="ToolButton_Click" Background="Transparent" CornerRadius="6">
                            <StackPanel Spacing="5"><TextBlock HorizontalAlignment="Center" FontSize="35" Text="▧" /><TextBlock HorizontalAlignment="Center" FontSize="13" Text="⌄" /></StackPanel>
                        </ToggleButton>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="選択した部分" />
                    </Grid>
                    <Rectangle Grid.Column="1" Width="1" Fill="#FFE6E6E6" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="18,8">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="CropMenuItem" Grid.Row="0" Grid.Column="0" Style="{StaticResource RibbonButton}" Click="Crop_Click" IsEnabled="False" ToolTipService.ToolTip="トリミング"><TextBlock Text="⌜" /></Button>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource RibbonButton}" Click="Resize_Click" ToolTipService.ToolTip="サイズ変更"><TextBlock Text="↗" /></Button>
                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="Import_Click" ToolTipService.ToolTip="キャンバスにインポート"><TextBlock Text="▧" /></Button>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource RibbonButton}" Click="BackgroundRemoval_Click" ToolTipService.ToolTip="背景の削除"><TextBlock Text="▥" /></Button>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource RibbonButton}" Click="Rotate_Click" ToolTipService.ToolTip="回転"><TextBlock Text="◢" /></Button>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="Rotate_Click" ToolTipService.ToolTip="回転メニュー"><TextBlock FontSize="14" Text="⌄" /></Button>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="イメージ" />
                    </Grid>
                    <Rectangle Grid.Column="3" Width="1" Fill="#FFE6E6E6" />

                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="17,8">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="PencilToolButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource RibbonToggle}" Tag="Pencil" IsChecked="True" Click="ToolButton_Click" ToolTipService.ToolTip="鉛筆"><TextBlock Text="✎" /></ToggleButton>
                            <ToggleButton x:Name="FillToolButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource RibbonToggle}" Tag="Fill" Click="ToolButton_Click" ToolTipService.ToolTip="塗りつぶし"><TextBlock Text="◩" /></ToggleButton>
                            <ToggleButton x:Name="TextToolButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource RibbonToggle}" Tag="Text" Click="ToolButton_Click" ToolTipService.ToolTip="テキスト"><TextBlock Text="A" /></ToggleButton>
                            <ToggleButton x:Name="EraserToolButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource RibbonToggle}" Tag="Eraser" Click="ToolButton_Click" ToolTipService.ToolTip="消しゴム"><TextBlock Text="◇" /></ToggleButton>
                            <ToggleButton x:Name="PickerToolButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource RibbonToggle}" Tag="Picker" Click="ToolButton_Click" ToolTipService.ToolTip="スポイト"><TextBlock Text="⚕" /></ToggleButton>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource RibbonButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="拡大鏡"><TextBlock Text="⌕" /></Button>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="ツール" />
                    </Grid>
                    <Rectangle Grid.Column="5" Width="1" Fill="#FFE6E6E6" />

                    <Grid Grid.Column="6">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <ToggleButton x:Name="BrushToolButton" Grid.Row="0" Width="62" Height="76" Margin="8,7" Tag="Brush" Click="BrushButton_Click" Background="Transparent" CornerRadius="6" ToolTipService.ToolTip="ブラシの種類">
                            <StackPanel Spacing="4"><TextBlock x:Name="BrushGlyph" HorizontalAlignment="Center" FontSize="29" Text="♠" /><TextBlock HorizontalAlignment="Center" FontSize="13" Text="⌄" /></StackPanel>
                        </ToggleButton>
                        <TextBlock x:Name="BrushNameText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="ブラシ" />
                    </Grid>
                    <Rectangle Grid.Column="7" Width="1" Fill="#FFE6E6E6" />

                    <Grid Grid.Column="8">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ShapeButton}" Content="╲" Tag="Line" Click="ShapeButton_Click" /><Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ShapeButton}" Content="∿" Tag="Curve" Click="ShapeButton_Click" /><Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ShapeButton}" Content="○" Tag="Ellipse" Click="ShapeButton_Click" /><Button Grid.Row="0" Grid.Column="3" Style="{StaticResource ShapeButton}" Content="□" Tag="Rectangle" Click="ShapeButton_Click" /><Button Grid.Row="0" Grid.Column="4" Style="{StaticResource ShapeButton}" Content="▢" Tag="RoundedRectangle" Click="ShapeButton_Click" /><Button Grid.Row="0" Grid.Column="5" Style="{StaticResource ShapeButton}" Content="▱" Tag="Parallelogram" Click="ShapeButton_Click" /><Button Grid.Row="0" Grid.Column="6" Style="{StaticResource ShapeButton}" Content="△" Tag="Triangle" Click="ShapeButton_Click" />
                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ShapeButton}" Content="◿" Tag="RightTriangle" Click="ShapeButton_Click" /><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ShapeButton}" Content="◇" Tag="Diamond" Click="ShapeButton_Click" /><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ShapeButton}" Content="⬠" Tag="Pentagon" Click="ShapeButton_Click" /><Button Grid.Row="1" Grid.Column="3" Style="{StaticResource ShapeButton}" Content="⬡" Tag="Hexagon" Click="ShapeButton_Click" /><Button Grid.Row="1" Grid.Column="4" Style="{StaticResource ShapeButton}" Content="➡" Tag="RightArrow" Click="ShapeButton_Click" /><Button Grid.Row="1" Grid.Column="5" Style="{StaticResource ShapeButton}" Content="⬅" Tag="LeftArrow" Click="ShapeButton_Click" /><Button Grid.Row="1" Grid.Column="6" Style="{StaticResource ShapeButton}" Content="⬆" Tag="UpArrow" Click="ShapeButton_Click" />
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource ShapeButton}" Content="⬇" Tag="DownArrow" Click="ShapeButton_Click" /><Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ShapeButton}" Content="✧" Tag="FourPointStar" Click="ShapeButton_Click" /><Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ShapeButton}" Content="☆" Tag="Star" Click="ShapeButton_Click" /><Button Grid.Row="2" Grid.Column="3" Style="{StaticResource ShapeButton}" Content="★" Tag="FilledStar" Click="ShapeButton_Click" /><Button Grid.Row="2" Grid.Column="4" Style="{StaticResource ShapeButton}" Content="▱" Tag="Callout" Click="ShapeButton_Click" /><Button Grid.Row="2" Grid.Column="5" Style="{StaticResource ShapeButton}" Content="◯" Tag="Oval" Click="ShapeButton_Click" /><Button Grid.Row="2" Grid.Column="6" Style="{StaticResource ShapeButton}" Content="☁" Tag="Cloud" Click="ShapeButton_Click" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="10,2,0,2">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Button x:Name="OutlineStyleButton" Grid.Row="0" HorizontalAlignment="Stretch" Padding="2" Background="Transparent" Click="OutlineStyle_Click" ToolTipService.ToolTip="輪郭"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock FontSize="19" Foreground="#FF777777" Text="▱" /><TextBlock FontSize="12" Text="⌄" /><TextBlock x:Name="OutlineStyleText" VerticalAlignment="Center" FontSize="11" Text="単色" /></StackPanel></Button>
                                <Button x:Name="FillStyleButton" Grid.Row="1" HorizontalAlignment="Stretch" Padding="2" Background="Transparent" Click="FillStyle_Click" ToolTipService.ToolTip="塗りつぶし"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock FontSize="19" Foreground="#FF777777" Text="◩" /><TextBlock FontSize="12" Text="⌄" /><TextBlock x:Name="FillStyleText" VerticalAlignment="Center" FontSize="11" Text="なし" /></StackPanel></Button>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="図形" />
                    </Grid>
                    <Rectangle Grid.Column="9" Width="1" Fill="#FFE6E6E6" />

                    <Grid Grid.Column="10">
                        <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="300" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Ellipse x:Name="PrimaryColorIndicator" Width="43" Height="43" VerticalAlignment="Top" Margin="0,1,0,0" Fill="Black" Stroke="#FF7B70DF" StrokeThickness="3" />
                                <Ellipse x:Name="SecondaryColorIndicator" Width="34" Height="34" VerticalAlignment="Bottom" Margin="0,0,0,1" Fill="White" Stroke="#FFAAAAAA" StrokeThickness="1" />
                                <Border x:Name="PrimaryColorBox" Width="1" Height="1" Background="Black" Opacity="0" />
                                <Border x:Name="SecondaryColorBox" Width="1" Height="1" Background="White" Opacity="0" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="5,0">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Swatch}" Tag="#FF000000" Background="#FF000000" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Swatch}" Tag="#FF7F7F7F" Background="#FF7F7F7F" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Swatch}" Tag="#FF880015" Background="#FF880015" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="3" Style="{StaticResource Swatch}" Tag="#FFED1C24" Background="#FFED1C24" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="4" Style="{StaticResource Swatch}" Tag="#FFFF7F27" Background="#FFFF7F27" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="5" Style="{StaticResource Swatch}" Tag="#FFFFF200" Background="#FFFFF200" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="6" Style="{StaticResource Swatch}" Tag="#FF22B14C" Background="#FF22B14C" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="7" Style="{StaticResource Swatch}" Tag="#FF00A2E8" Background="#FF00A2E8" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="8" Style="{StaticResource Swatch}" Tag="#FF3F48CC" Background="#FF3F48CC" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="0" Grid.Column="9" Style="{StaticResource Swatch}" Tag="#FFA349A4" Background="#FFA349A4" Click="Palette_Click" PointerPressed="Palette_PointerPressed" />
                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Swatch}" Tag="#FFFFFFFF" Background="#FFFFFFFF" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Swatch}" Tag="#FFC3C3C3" Background="#FFC3C3C3" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Swatch}" Tag="#FFB97A57" Background="#FFB97A57" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="3" Style="{StaticResource Swatch}" Tag="#FFFFAEC9" Background="#FFFFAEC9" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="4" Style="{StaticResource Swatch}" Tag="#FFFFC90E" Background="#FFFFC90E" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="5" Style="{StaticResource Swatch}" Tag="#FFEFE4B0" Background="#FFEFE4B0" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="6" Style="{StaticResource Swatch}" Tag="#FFB5E61D" Background="#FFB5E61D" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="7" Style="{StaticResource Swatch}" Tag="#FF99D9EA" Background="#FF99D9EA" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="8" Style="{StaticResource Swatch}" Tag="#FF7092BE" Background="#FF7092BE" Click="Palette_Click" PointerPressed="Palette_PointerPressed" /><Button Grid.Row="1" Grid.Column="9" Style="{StaticResource Swatch}" Tag="#FFC8BFE7" Background="#FFC8BFE7" Click="Palette_Click" PointerPressed="Palette_PointerPressed" />
                            </Grid>
                            <Button Grid.Column="2" Width="50" Height="72" Click="EditColors_Click" Background="Transparent" ToolTipService.ToolTip="色の編集"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="34" Text="🌈" /><TextBlock FontSize="13" Text="＋" HorizontalAlignment="Right" /></StackPanel></Button>
                        </Grid>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="色" />
                    </Grid>
                    <Rectangle Grid.Column="11" Width="1" Fill="#FFE6E6E6" />

                    <Grid Grid.Column="12"><Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions><Button Grid.Row="0" Width="62" Height="76" Margin="8,7" Background="Transparent"><TextBlock FontSize="34" Text="🌈" /></Button><TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="Copilot" /></Grid>
                    <Rectangle Grid.Column="13" Width="1" Fill="#FFE6E6E6" />
                    <Grid Grid.Column="14"><Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="36" /></Grid.RowDefinitions><Button Grid.Row="0" Width="62" Height="76" Margin="9,7" Click="Layers_Click" Background="Transparent" CornerRadius="6"><TextBlock FontSize="35" Text="▱" /></Button><TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#FF555555" Text="レイヤー" /></Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LayersColumn" Width="148" /></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="WorkspaceScroller" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" Background="#FFF4F4F4">
                <Grid MinWidth="1200" MinHeight="720">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="RulerCorner" Width="32" Height="24" Background="#FFF8F8F8" BorderBrush="#FFBEBEBE" BorderThickness="0,0,1,1" Visibility="Collapsed" />
                        <canvas:CanvasControl x:Name="HorizontalRuler" Grid.Column="1" Height="24" Visibility="Collapsed" Draw="HorizontalRuler_Draw" />
                        <canvas:CanvasControl x:Name="VerticalRuler" Grid.Row="1" Width="32" Visibility="Collapsed" Draw="VerticalRuler_Draw" />
                        <Grid x:Name="CanvasHost" Grid.Row="1" Grid.Column="1">
                            <Border Background="White" BorderBrush="#FF9A9A9A" BorderThickness="1">
                                <canvas:CanvasControl x:Name="PaintCanvas" Width="1152" Height="648" Draw="PaintCanvas_Draw" PointerPressed="PaintCanvas_PointerPressed" PointerMoved="PaintCanvas_PointerMoved" PointerReleased="PaintCanvas_PointerReleased" PointerExited="PaintCanvas_PointerReleased" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
                <Border Width="50" Height="450" Padding="10,12" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#FFE5E5E5" BorderThickness="1"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="20" Text="≋" /><Slider x:Name="StrokeWidthSlider" Height="385" Orientation="Vertical" Minimum="1" Maximum="40" Value="3" ValueChanged="StrokeWidthSlider_ValueChanged" /><TextBlock x:Name="StrokeWidthText" Visibility="Collapsed" Text="3 px" /></StackPanel></Border>
                <Border Width="50" Height="450" Padding="10,12" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#FFE5E5E5" BorderThickness="1"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="20" Text="◕" /><Slider x:Name="OpacitySlider" Height="385" Orientation="Vertical" Minimum="1" Maximum="100" Value="100" /></StackPanel></Border>
            </StackPanel>
            <Border Grid.Column="1" Width="132" Margin="0,16,16,16" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#FFFAFAFA" BorderBrush="#FFE3E3E3" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="130" /></Grid.RowDefinitions>
                    <Grid><Button Width="34" Height="34" HorizontalAlignment="Center" Click="AddLayer_Click" Content="＋" /><Button Width="30" Height="30" Margin="0,0,5,0" HorizontalAlignment="Right" Click="Layers_Click" Content="×" /></Grid>
                    <ListView x:Name="LayersList" Grid.Row="1" Margin="8" SelectionMode="Single">
                        <ListViewItem IsSelected="True"><Border Width="102" Height="80" Background="White" BorderBrush="#FF746BE1" BorderThickness="1" CornerRadius="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="背景" /></Border></ListViewItem>
                    </ListView>
                    <Border Grid.Row="2" Margin="10" Padding="6" Background="#FFFFFFFF" CornerRadius="7" BorderBrush="#FFE3E3E3" BorderThickness="1">
                        <Grid RowSpacing="4" ColumnSpacing="4">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Height="38" Padding="0" Click="MoveLayerUp_Click" ToolTipService.ToolTip="上へ移動" Content="↑" /><Button Grid.Row="0" Grid.Column="1" Height="38" Padding="0" Click="MoveLayerDown_Click" ToolTipService.ToolTip="下へ移動" Content="↓" />
                            <Button Grid.Row="1" Grid.Column="0" Height="38" Padding="0" Click="MergeLayerDown_Click" ToolTipService.ToolTip="下のレイヤーと結合" Content="⇲" /><Button Grid.Row="1" Grid.Column="1" Height="38" Padding="0" Click="RenameLayer_Click" ToolTipService.ToolTip="名前の変更" Content="✎" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="StatusBar" Grid.Row="3" Background="#FFFAFAFA" BorderBrush="#FFE3E3E3" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="165" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="114" /><ColumnDefinition Width="44" /><ColumnDefinition Width="170" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock FontSize="19" Text="⌁" /><TextBlock x:Name="PointerStatusText" VerticalAlignment="Center" FontSize="13" Text="0, 0 px" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock FontSize="18" Text="▧" /><TextBlock x:Name="CanvasSizeText" VerticalAlignment="Center" FontSize="13" Text="1152 × 648px" /></StackPanel>
            <Button Grid.Column="3" Width="38" Height="36" Padding="0" Background="Transparent" Click="ResetZoom_Click" Content="⌾" />
            <ComboBox x:Name="ZoomComboBox" Grid.Column="4" Width="114" Height="36" IsEditable="True" Text="100%" SelectionChanged="ZoomComboBox_SelectionChanged"><ComboBoxItem Content="25%" Tag="25" /><ComboBoxItem Content="50%" Tag="50" /><ComboBoxItem Content="100%" Tag="100" /><ComboBoxItem Content="200%" Tag="200" /><ComboBoxItem Content="400%" Tag="400" /><ComboBoxItem Content="800%" Tag="800" /></ComboBox>
            <Button Grid.Column="5" Width="38" Height="36" Padding="0" Background="Transparent" Click="ZoomOut_Click" Content="⌕" />
            <Slider x:Name="ZoomSlider" Grid.Column="6" Minimum="25" Maximum="800" Value="100" ValueChanged="ZoomSlider_ValueChanged" />
            <Button Grid.Column="7" Width="38" Height="36" Padding="0" Background="Transparent" Click="ZoomIn_Click" Content="⊕" />
        </Grid>
    </Grid>
</Window>
