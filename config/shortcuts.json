{
  "schemaVersion": 1,
  "shortcuts": [
    {
      "keys": "Ctrl+N",
      "id": "editor-1",
      "description": "新しい空ウィンドウ",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+O",
      "id": "editor-2",
      "description": "画像を別ウィンドウで開く",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+S",
      "id": "editor-3",
      "description": "PNG/JPEG保存",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+Z",
      "id": "editor-4",
      "description": "元に戻す",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+Y",
      "id": "editor-5",
      "description": "やり直す",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+C",
      "id": "editor-7",
      "description": "図形選択のみなら選択対象の外周矩形をコピー。矩形範囲あり・無選択ならキャンバス全体をコピー",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+V",
      "id": "editor-8",
      "description": "重ねて貼り付け（キャンバスを縮小しない）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+Shift+V",
      "id": "editor-paste-options",
      "description": "重ねる・上・下・左・右を選んで貼り付け",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+E",
      "id": "editor-raster-merge",
      "description": "選択図形を透過背景の1枚のラスタ画像へ統合（Undoで元に戻せる）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+Shift+S",
      "id": "editor-save-as",
      "description": "名前を付けてPNG/JPEG保存",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Alt+F",
      "id": "editor-file-menu",
      "description": "ファイルメニューを開く",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Delete",
      "id": "editor-delete",
      "description": "注釈・範囲を削除",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Esc",
      "id": "editor-cancel",
      "description": "操作・選択を解除",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+A",
      "id": "select-all",
      "description": "キャンバス全体の範囲を選択",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+PageUp",
      "id": "stack-forward",
      "description": "選択対象を1つ前へ",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+PageDown",
      "id": "stack-backward",
      "description": "選択対象を1つ後ろへ",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "V",
      "id": "tool-select",
      "description": "選択・移動へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "M",
      "id": "tool-region",
      "description": "矩形範囲へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "B",
      "id": "tool-pen",
      "description": "ペンへ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "E",
      "id": "tool-eraser",
      "description": "消しゴムへ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "A",
      "id": "tool-arrow",
      "description": "矢印へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "R",
      "id": "tool-rectangle",
      "description": "四角へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "O",
      "id": "tool-ellipse",
      "description": "丸へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "L",
      "id": "tool-line",
      "description": "直線へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "T",
      "id": "tool-text",
      "description": "文字へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "N",
      "id": "tool-number",
      "description": "番号へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "K",
      "id": "tool-redact",
      "description": "塗りつぶし四角（情報隠し）へ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "H",
      "id": "tool-highlight",
      "description": "蛍光ペンへ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "F",
      "id": "tool-blur",
      "description": "ぼかしへ切替（単独F）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Q",
      "id": "tool-callout",
      "description": "吹き出しへ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "X",
      "id": "tool-mosaic",
      "description": "モザイクへ切替（Altとの組合せも可）",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+X",
      "id": "editor-cut",
      "description": "選択範囲・対象をコピーして削除",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+Wheel",
      "id": "editor-wheel-zoom",
      "description": "ポインタ位置を基準に表示を拡大縮小",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "Ctrl+Shift+X",
      "id": "editor-crop",
      "description": "矩形範囲を優先し、なければ選択図形すべての外周でキャンバスを切り抜く",
      "scope": "application",
      "configurable": false
    },
    {
      "keys": "I",
      "id": "editor-eyedropper",
      "description": "ドラッグ中の合成色を表示し、離した地点でスポイトの色を確定",
      "scope": "application",
      "configurable": false
    }
  ]
}
